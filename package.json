{
  "name": "ModernSwiss",
  "version": "1.0.0",
  "description": "ModernSwiss Watchface - SBB style on reborn Pebble",
  "main": "src/js/app.js",
  "keywords": [
    "pebble",
    "watchface"
  ],
  "author": "Maartje Eyskens",
  "license": "MIT",
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "ModernSwiss",
    "uuid": "8c950574-2e93-4dff-97d1-d8fe5cdb9b6c",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": {
      "DialColor": 0,
      "SecondHandOption": 1,
      "DateOption": 2,
      "HourlyVibration": 3,
      "BluetoothStatusDetection": 4,
      "RoundBackgroundColor": 5
    },
    "resources": {
      "media": [
        {
